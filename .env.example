# Environment variables read by live/<env>/env.hcl and the deploy workflows.
# Copy to .env.local (gitignored) and `source` it, or set them in your shell /
# CI environment. Nothing in this file is committed with a real value.

# AWS account the env deploys into. root.hcl pins the provider to it, so a
# credential for any other account is rejected before a plan runs.
AWS_ACCOUNT=
AWS_REGION=us-east-2

# Parent DNS zone the env's hostnames live under. The env is served at
# <env>.<PORTAL_DOMAIN_ROOT>, Cognito's hosted UI at auth.<env>.<root>, and
# the GraphQL endpoint at gql.<env>.<root>.
PORTAL_DOMAIN_ROOT=
ROUTE53_ZONE_ID=

# Comma-separated email domains allowed to sign in (Cognito pre-sign-up gate).
ALLOWED_EMAIL_DOMAINS=example.com

# Your Glean tenant's backend origin: https://<tenant>-be.glean.com
GLEAN_BASE_URL=
