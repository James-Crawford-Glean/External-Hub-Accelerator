# Copy to .env.local and fill in. The deploy workflow sets these from
# `terragrunt output`; locally, point at a deployed environment.

# White-label GraphQL endpoint, https://gql.<env>.<domain_root>/graphql
VITE_GRAPHQL_URL=

# Cognito OIDC (outputs of live/<env>/infra/cognito):
#   VITE_COGNITO_AUTHORITY     = issuer_url
#   VITE_COGNITO_CLIENT_ID     = app_client_id
#   VITE_COGNITO_HOSTED_DOMAIN = hosted_ui_domain
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_HOSTED_DOMAIN=
# Identity provider to send users straight to (skips the hosted-UI chooser).
VITE_COGNITO_IDP=Google

# Path the app is served under in the multi-app bucket (env.hcl spa_default_app).
VITE_APP_PATH=portal

# Display name in the shell.
VITE_PORTAL_NAME=Portal

# Dev-only: where Vite proxies /glean-api/* (a deployed env's origin).
VITE_GLEAN_PROXY_TARGET=

# Admin > AWS deep links; the deploy workflow fills these from the env.
VITE_ENV=
VITE_AWS_ACCOUNT_ID=
VITE_AWS_REGION=us-east-2
VITE_AWS_DASHBOARD_NAME=
VITE_AWS_BILLING_DASHBOARD_NAME=

# CloudWatch RUM (outputs of live/<env>/app/rum); unset = telemetry off.
VITE_RUM_APP_MONITOR_ID=
VITE_RUM_IDENTITY_POOL_ID=
