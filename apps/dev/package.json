{
  "name": "dev-portal",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "docusaurus": "docusaurus",
    "gen:graphql": "docusaurus graphql-to-doc --force",
    "start": "pnpm gen:graphql && docusaurus start",
    "build": "pnpm gen:graphql && docusaurus build --out-dir dist",
    "serve": "docusaurus serve --dir dist",
    "clear": "docusaurus clear",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@aws-icons/react": "^4.1.0",
    "@docusaurus/core": "^3.6.0",
    "@docusaurus/preset-classic": "^3.6.0",
    "@graphiql/toolkit": "^0.12.1",
    "@graphql-markdown/docusaurus": "^1.26.0",
    "@graphql-tools/graphql-file-loader": "^8.0.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "graphiql": "^3.9.0",
    "graphql": "^16.9.0",
    "mermaid": "^11.17.0",
    "oidc-client-ts": "^3.5.0",
    "prism-react-renderer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-oidc-context": "^3.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.6.0",
    "@docusaurus/tsconfig": "^3.6.0",
    "@docusaurus/types": "^3.6.0",
    "@types/node": "^24.12.3",
    "dotenv": "^16.4.5",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=20.0"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": "7.0.3",
      "image-size": "npm:image-size-next@2.1.0"
    }
  }
}
