{
  "name": "portal-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Node Lambda backend: one monorepo -> many Lambda bundles (api, authorizer, mcp, stream, workers) over shared libs; plain constructor DI via @libs/di once().",
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "format": "prettier --write \"{apps,libs}/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1146.0",
    "@aws-sdk/client-dynamodb": "^3.1079.0",
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-rds-data": "^3.700.0",
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/client-secrets-manager": "^3.1079.0",
    "@aws-sdk/lib-dynamodb": "^3.1079.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "node": ">=20"
  }
}
